{
  "name": "mender",
  "version": "1.5.0",
  "description": "Scrapers that repair themselves. Diagnoses why extraction broke, refuses to touch selectors when the page was blocked, proposes a fix with heuristics then a model, and proves it against every archived snapshot before opening a PR.",
  "type": "module",
  "bin": {
    "mender": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node test/run.mjs",
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "keywords": [
    "scraping",
    "self-healing",
    "css-selector",
    "agent",
    "llm",
    "monitoring",
    "data-quality",
    "drift-detection"
  ],
  "license": "MIT",
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "assets/logo.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daronthedragon/mender.git"
  },
  "homepage": "https://github.com/daronthedragon/mender#readme",
  "bugs": {
    "url": "https://github.com/daronthedragon/mender/issues"
  },
  "author": "Daron",
  "sideEffects": false
}
